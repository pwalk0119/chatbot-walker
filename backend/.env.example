# Copy to backend/.env and fill in real values. Never commit backend/.env.

# PostgreSQL with pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pnw_chatbot

# Anthropic Claude API (answer generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5

# Self-hosted sentence-transformers embedding model (768-dim)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Current academic term; documents tagged with an earlier term are excluded (FR-005)
CURRENT_TERM=Fall 2026

# Transcript retention in days; must not exceed 90 (FR-011)
RETENTION_DAYS=90

# Comma-separated origins allowed to embed the widget (CORS)
ALLOWED_WIDGET_ORIGINS=http://localhost:5173
